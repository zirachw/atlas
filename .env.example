# Harmless examples only. Copy to .env and change local credentials.
POSTGRES_ADMIN_PASSWORD=example-admin-only
CANONICAL_DB_PASSWORD=example-canonical-only
AUTH_DB_PASSWORD=example-auth-only
RABBITMQ_USER=atlas
RABBITMQ_PASSWORD=example-broker-only
BMKG_API_KEY=example-bmkg-only
PVMBG_TOKEN=example-pvmbg-only
AGGREGATOR_INTERNAL_TOKEN=example-internal-only
BMKG_BASE_URL=http://bmkg:8081
PVMBG_BASE_URL=http://pvmbg:8082
AGGREGATOR_PORT=8083
POLL_INTERVAL=3s
SOURCE_TIMEOUT=4s
SOURCE_RETRIES=2
RETRY_BACKOFF=200ms
QUERY_TIMEOUT=2s
QUERY_CAPACITY=64
QUERY_POOL_SIZE=8
INGEST_POOL_SIZE=2
PUBLISH_TIMEOUT=3s
PUBLISH_RETRIES=2
PUBLISH_CAPACITY=256

# Run `make env` to fill the empty secrets. Never commit .env.

## PVMBG_TOKEN is shaped pvmbg.<key-id>.<secret>.
BMKG_API_KEY=
PVMBG_TOKEN=
AGGREGATOR_INTERNAL_TOKEN=
AUTH_VALIDATE_TOKEN=
AUTH_ED25519_PRIVATE_KEY_B64=
AUTH_ED25519_PUBLIC_KEY_B64=

MEDIA_CLIENT_ID=media
MEDIA_CLIENT_SECRET=
FIELD_TEAM_CLIENT_ID=field-team
FIELD_TEAM_CLIENT_SECRET=
INTERNAL_OPS_CLIENT_ID=internal-ops
INTERNAL_OPS_CLIENT_SECRET=

CANONICAL_DB_PASSWORD=
AUTH_DB_PASSWORD=
BMKG_DB_PASSWORD=
PVMBG_DB_PASSWORD=
RABBITMQ_PASSWORD=

## Superuser of the BNPB Postgres container, used once to create the owner roles.
POSTGRES_ADMIN_PASSWORD=

# Everything below is optional and matches the built-in defaults.

## Spec: BMKG 8081, PVMBG 8082, Client API 8080.
BMKG_PORT=8081
PVMBG_PORT=8082
CLIENT_API_PORT=8080
AUTH_PORT=8084

## Spec: PVMBG 500ms-3s, events at most 10s apart.
PVMBG_MIN_RESPONSE_DELAY=500ms
PVMBG_MAX_RESPONSE_DELAY=3s
SOURCE_EVENT_INTERVAL=10s

## Spec: polling every 2s-5s suggested.
POLL_INTERVAL=3s

## Spec: access token TTL defaults to 60s.
ACCESS_TOKEN_TTL=60s

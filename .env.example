# Harmless local examples. Copy to .env and replace credentials before use.
POSTGRES_ADMIN_PASSWORD=example-admin-only
CANONICAL_DB_PASSWORD=example-canonical-only
AUTH_DB_PASSWORD=example-auth-only
# Each source agency owns its own database server.
BMKG_DB_PASSWORD=example-bmkg-store-only
PVMBG_DB_PASSWORD=example-pvmbg-store-only
RABBITMQ_USER=atlas
RABBITMQ_PASSWORD=example-broker-only

# Separate source and Aggregator credentials. PVMBG_TOKEN uses the form pvmbg.<key-id>.<secret>.
BMKG_API_KEY=example-bmkg-only
PVMBG_TOKEN=pvmbg.demo.example-pvmbg-secret-only
AGGREGATOR_INTERNAL_TOKEN=example-aggregator-internal-only

# Downstream client identities. The Auth service assigns scopes by identity.
MEDIA_CLIENT_ID=media-demo
MEDIA_CLIENT_SECRET=example-media-secret
FIELD_TEAM_CLIENT_ID=field-team-demo
FIELD_TEAM_CLIENT_SECRET=example-field-team-secret
INTERNAL_OPS_CLIENT_ID=internal-ops-demo
INTERNAL_OPS_CLIENT_SECRET=example-internal-ops-secret

# Generate a dedicated Ed25519 pair and replace these placeholders.
AUTH_ED25519_PRIVATE_KEY_B64=REPLACE_WITH_BASE64_PKCS8_PEM
AUTH_ED25519_PUBLIC_KEY_B64=REPLACE_WITH_BASE64_SUBJECTPUBLICKEYINFO_PEM
AUTH_VALIDATE_TOKEN=example-auth-validation-only
ACCESS_TOKEN_TTL=60s
REFRESH_TOKEN_TTL=168h

# Local host ports.
BMKG_PORT=8081
PVMBG_PORT=8082
CLIENT_API_PORT=8080
AUTH_PORT=8084

# Source mock behavior. Set both PVMBG delays to 3s for the fixed P2 delay.
BMKG_RESPONSE_DELAY=100ms
PVMBG_MIN_RESPONSE_DELAY=500ms
PVMBG_MAX_RESPONSE_DELAY=3s
SOURCE_EVENT_INTERVAL=10s

# Aggregator behavior.
POLL_INTERVAL=3s
SOURCE_TIMEOUT=4s
SOURCE_RETRIES=2
RETRY_BACKOFF=200ms
QUERY_TIMEOUT=2s
QUERY_CAPACITY=64
QUERY_POOL_SIZE=8
INGEST_POOL_SIZE=2
PUBLISH_TIMEOUT=3s
PUBLISH_RETRIES=2
PUBLISH_CAPACITY=256

# Client API and event consumers.
CLIENT_API_OUTBOUND_TIMEOUT=3s
CLIENT_API_REQUEST_CAPACITY=128
CONSUMER_PREFETCH=1
CONSUMER_QUEUE_MAX_LENGTH=10000
CONSUMER_QUEUE_MAX_BYTES=67108864
CONSUMER_MESSAGE_TTL=1h
CONSUMER_A_NAME=consumer-a
CONSUMER_A_QUEUE=hazard.events.consumer-a
CONSUMER_B_NAME=consumer-b
CONSUMER_B_QUEUE=hazard.events.consumer-b
CONSUMER_C_NAME=consumer-c
CONSUMER_C_QUEUE=hazard.events.consumer-c
